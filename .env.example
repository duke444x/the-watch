# Anthropic API key (required)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Anthropic model to use (optional)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Discord webhook URL for the broadcast step (required for Discord broadcasting)
# Create one in your Discord server: Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-token

# Optional: dashboard port (defaults to 3000)
PORT=3000

# Optional: path to the kraken-cli binary if not on PATH
# KRAKEN_CLI=/root/.cargo/bin/kraken
