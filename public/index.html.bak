<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Capt's Ledger · The Watch</title>
  <link rel="icon" href="/captcrawl.png" />
  <style>
    /* ─── Brand palette ────────────────────────────────────────────────── */
    :root {
      --bg-deep:        #08090d;
      --bg-card:        #14171f;
      --bg-card-hi:     #1a1f2b;
      --border:         #2a2f3b;
      --border-hi:      #3a4150;
      --text-primary:   #e6edf3;
      --text-muted:     #8b949e;
      --text-dim:       #6e7681;
      --teal:           #2DD4BF;
      --teal-glow:      rgba(45, 212, 191, 0.15);
      --coral:          #FB7185;
      --coral-glow:     rgba(251, 113, 133, 0.15);
      --gold:           #F9C015;
      --gold-glow:      rgba(249, 192, 21, 0.15);
      --rebel-red:      #E60000;
      --sky:            #61A6DD;
      --mono: 'SF Mono', 'JetBrains Mono', Menlo, Monaco, 'Cascadia Mono', 'Courier New', monospace;
      --display: ui-serif, Georgia, 'Times New Roman', serif;
    }

    /* ─── Reset / base ─────────────────────────────────────────────────── */
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      background: var(--bg-deep);
      color: var(--text-primary);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.5;
      min-height: 100vh;
      background-image:
        radial-gradient(ellipse 80% 40% at 50% -10%, rgba(249, 192, 21, 0.05) 0%, transparent 70%),
        radial-gradient(ellipse 60% 30% at 50% 110%, rgba(45, 212, 191, 0.04) 0%, transparent 70%);
      background-attachment: fixed;
    }
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: repeating-linear-gradient(
        135deg,
        transparent 0,
        transparent 24px,
        rgba(255, 255, 255, 0.008) 24px,
        rgba(255, 255, 255, 0.008) 25px
      );
      pointer-events: none;
      z-index: 0;
    }
    .wrap { position: relative; z-index: 1; }
    a { color: var(--teal); text-decoration: none; }
    a:hover { text-decoration: underline; }

    .mono { font-family: var(--mono); }
    .pos  { color: var(--teal); }
    .neg  { color: var(--coral); }
    .dim  { color: var(--text-dim); }
    .muted { color: var(--text-muted); }

    /* ─── Layout ──────────────────────────────────────────────────────── */
    .wrap {
      max-width: 1020px;
      margin: 0 auto;
      padding: 24px 24px 60px;
    }

    /* ─── Hero banner ─────────────────────────────────────────────────── */
    .hero {
      position: relative;
      height: 340px;
      border-radius: 14px;
      overflow: hidden;
      margin-bottom: 28px;
      border: 1px solid var(--border);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
    }
    .hero-image {
      position: absolute;
      inset: 0;
      background-image: url('/plank-hero.png');
      background-size: cover;
      background-position: center 60%;
      transition: transform 8s ease-out;
    }
    .hero:hover .hero-image {
      transform: scale(1.04);
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to bottom,
          rgba(8, 9, 13, 0.3) 0%,
          rgba(8, 9, 13, 0) 30%,
          rgba(8, 9, 13, 0.4) 65%,
          rgba(8, 9, 13, 0.95) 100%);
    }
    .hero-content {
      position: absolute;
      bottom: 28px;
      left: 36px;
      right: 36px;
      z-index: 2;
    }
    .hero h1 {
      font-family: var(--display);
      font-size: 52px;
      font-weight: 600;
      color: var(--gold);
      letter-spacing: -1px;
      line-height: 1;
      text-shadow:
        0 0 30px rgba(249, 192, 21, 0.4),
        0 2px 20px rgba(0, 0, 0, 0.8);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .hero h1 .pirate {
      font-size: 56px;
      filter: drop-shadow(0 0 16px rgba(249, 192, 21, 0.55));
      line-height: 1;
      animation: flag-wave 4s ease-in-out infinite;
    }
    @keyframes flag-wave {
      0%, 100% { transform: rotate(-2deg); filter: drop-shadow(0 0 16px rgba(249, 192, 21, 0.55)); }
      50%      { transform: rotate(2deg);  filter: drop-shadow(0 0 24px rgba(249, 192, 21, 0.75)); }
    }
    .hero .tagline {
      color: rgba(230, 237, 243, 0.85);
      font-size: 13px;
      font-family: var(--mono);
      letter-spacing: 0.4px;
      text-shadow: 0 1px 8px rgba(0, 0, 0, 0.9);
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 2px 8px;
    }
    .hero .tagline .phrase { white-space: nowrap; }
    .hero .tagline .sep { color: rgba(110, 118, 129, 0.7); }
    .hero .tagline .accent { color: var(--teal); }
    .hero-brand {
      position: absolute;
      top: 20px;
      right: 20px;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background-image: url('/captcrawl.png');
      background-size: cover;
      background-position: center;
      border: 2px solid var(--gold);
      box-shadow:
        0 0 0 1px rgba(0, 0, 0, 0.3),
        0 4px 16px rgba(0, 0, 0, 0.5),
        0 0 24px rgba(249, 192, 21, 0.3);
      z-index: 2;
    }
    @media (max-width: 640px) {
      .hero { height: 240px; }
      .hero h1 { font-size: 32px; gap: 10px; }
      .hero h1 .pirate { font-size: 34px; }
      .hero .tagline { font-size: 11px; line-height: 1.6; }
      .hero-content { left: 20px; right: 20px; bottom: 20px; }
      .hero-brand { width: 44px; height: 44px; top: 14px; right: 14px; }
    }
    @media (max-width: 420px) {
      .hero { height: 210px; }
      .hero h1 { font-size: 26px; gap: 8px; margin-bottom: 8px; }
      .hero h1 .pirate { font-size: 28px; }
      .hero .tagline { font-size: 10px; gap: 2px 5px; }
      .hero-content { left: 16px; right: 16px; bottom: 16px; }
      .hero-brand { width: 38px; height: 38px; top: 12px; right: 12px; border-width: 1.5px; }
    }

    /* ─── Stats row ────────────────────────────────────────────────────── */
    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-bottom: 24px;
    }
    @media (max-width: 640px) {
      .stats { grid-template-columns: 1fr; }
    }
    .stat {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 18px 20px 20px;
      position: relative;
      overflow: hidden;
      transition: border-color 0.2s, transform 0.2s;
    }
    .stat::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: var(--accent, var(--border));
    }
    .stat.equity   { --accent: var(--sky); }
    .stat.pnl-pos  { --accent: var(--teal); }
    .stat.pnl-neg  { --accent: var(--coral); }
    .stat.active   { --accent: var(--teal); }
    .stat.paused   { --accent: var(--gold); }
    .stat:hover {
      border-color: var(--border-hi);
      transform: translateY(-1px);
    }
    .stat-label {
      font-size: 10px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1.2px;
      font-weight: 600;
      margin-bottom: 8px;
    }
    .stat-value {
      font-family: var(--mono);
      font-size: 28px;
      font-weight: 600;
      letter-spacing: -0.5px;
      line-height: 1.1;
    }
    .stat-sub {
      font-size: 11px;
      color: var(--text-dim);
      margin-top: 8px;
      font-family: var(--mono);
    }
    .active-indicator, .paused-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: -apple-system, sans-serif;
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.3px;
    }
    .active-indicator { color: var(--teal); }
    .paused-indicator { color: var(--gold); }
    .pulse-dot {
      display: inline-block;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--teal);
      box-shadow: 0 0 12px var(--teal);
      animation: pulse 2s ease-in-out infinite;
    }
    .paused-dot {
      display: inline-block;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--gold);
      box-shadow: 0 0 12px var(--gold);
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; box-shadow: 0 0 12px var(--teal); }
      50%      { opacity: 0.55; box-shadow: 0 0 20px var(--teal); }
    }

    /* ─── Markets / ticker cards ──────────────────────────────────────── */
    .markets {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-bottom: 18px;
    }
    @media (max-width: 920px) {
      .markets { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 600px) {
      .markets { grid-template-columns: 1fr; }
    }
    .ticker {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 18px 20px 16px;
      position: relative;
      overflow: hidden;
      transition: border-color 0.2s, transform 0.2s;
    }
    .ticker::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 3px;
      background: var(--accent, var(--border));
    }
    .ticker.t-hbar  { --accent: var(--teal); }
    .ticker.t-btc   { --accent: var(--gold); }
    .ticker.t-dog   { --accent: var(--coral); }
    .ticker.t-sol   { --accent: #9945FF; }
    .ticker.t-sui   { --accent: #4DA2FF; }

    /* ─── Stack Progress section ─────────────────────────────────────── */
    .stack-grid {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .stack-row {
      display: grid;
      grid-template-columns: 60px 1fr 1fr 1fr;
      gap: 14px;
      padding: 14px 16px;
      background: var(--bg-card-hi);
      border: 1px solid var(--border);
      border-radius: 8px;
      align-items: center;
      font-family: var(--mono);
      font-size: 13px;
    }
    @media (max-width: 640px) {
      .stack-row { grid-template-columns: 50px 1fr 1fr; }
      .stack-row .stack-was { display: none; }
    }
    .stack-row .stack-sym strong { font-size: 16px; color: var(--gold); }
    .stack-row .stack-now,
    .stack-row .stack-was,
    .stack-row .stack-delta { line-height: 1.4; }
    .stack-row .stack-delta { text-align: right; font-weight: 600; }
    .stack-row .stack-delta.pos { color: var(--teal); }
    .stack-row .stack-delta.neg { color: var(--coral); }
    .ticker:hover {
      border-color: var(--border-hi);
      transform: translateY(-1px);
    }
    .ticker-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 14px;
    }
    .ticker-symbol {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.6px;
      color: var(--text-primary);
    }
    .ticker-quote {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 500;
      letter-spacing: 0.4px;
    }
    .ticker-desc {
      font-size: 9.5px;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      text-align: right;
      flex: 1;
      font-family: var(--mono);
    }
    .ticker-price {
      font-family: var(--mono);
      font-size: 26px;
      font-weight: 600;
      letter-spacing: -0.5px;
      line-height: 1.1;
      margin-bottom: 10px;
      color: var(--text-primary);
    }
    .ticker-foot {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
      font-family: var(--mono);
      font-size: 11px;
    }
    .ticker-change {
      font-weight: 600;
    }
    .ticker-range {
      color: var(--text-dim);
      font-size: 10.5px;
    }

    /* ─── Section ──────────────────────────────────────────────────────── */
    section {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 22px 24px 24px;
      margin-bottom: 18px;
      transition: border-color 0.2s;
    }
    section:hover { border-color: var(--border-hi); }
    section h2 {
      font-size: 12px;
      font-weight: 700;
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 18px;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }
    section h2 .count {
      color: var(--text-dim);
      font-weight: 400;
      font-size: 11px;
      letter-spacing: 0.5px;
      font-family: var(--mono);
    }

    /* ─── Equity chart ────────────────────────────────────────────────── */
    .chart-wrap { width: 100%; position: relative; }
    .chart svg { display: block; width: 100%; height: 240px; }
    .chart-empty {
      color: var(--text-muted);
      padding: 50px 20px;
      text-align: center;
      font-style: italic;
      font-size: 13px;
      line-height: 1.7;
      background:
        repeating-linear-gradient(45deg,
          transparent 0, transparent 8px,
          rgba(45, 212, 191, 0.03) 8px, rgba(45, 212, 191, 0.03) 9px);
      border-radius: 8px;
      border: 1px dashed var(--border);
    }
    .chart-empty strong { color: var(--teal); font-style: normal; }
    .chart-line {
      fill: none;
      stroke: var(--teal);
      stroke-width: 2.5;
      stroke-linejoin: round;
      stroke-linecap: round;
      filter: drop-shadow(0 0 6px var(--teal-glow));
    }
    .chart-fill { fill: url(#equityGradient); opacity: 0.6; }
    .chart-baseline {
      fill: none;
      stroke: var(--text-dim);
      stroke-width: 1;
      stroke-dasharray: 4 6;
      opacity: 0.6;
    }
    .chart-axis { stroke: var(--border); stroke-width: 1; }
    .chart-label { fill: var(--text-muted); font-family: var(--mono); font-size: 10px; }
    .chart-dot { fill: var(--teal); filter: drop-shadow(0 0 4px var(--teal)); }

    /* ─── Position cards ─────────────────────────────────────────────── */
    .position {
      border: 1px solid var(--border);
      border-left: 3px solid var(--accent, var(--border));
      border-radius: 8px;
      padding: 16px 18px;
      margin-bottom: 12px;
      background: var(--bg-deep);
      transition: background 0.2s, transform 0.2s;
    }
    .position.tier-rail     { --accent: var(--sky); }
    .position.tier-one_out  { --accent: var(--teal); }
    .position.tier-two_out  { --accent: var(--coral); }
    .position.forced        { --accent: var(--gold); }
    .position:last-child    { margin-bottom: 0; }
    .position:hover {
      background: var(--bg-card-hi);
      transform: translateX(2px);
    }
    .position-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 14px;
    }
    .position-pair {
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.2px;
      color: var(--text-primary);
    }
    .position-tag {
      font-size: 10px;
      padding: 3px 8px;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      font-weight: 700;
      margin-left: 10px;
      vertical-align: middle;
    }
    .tag-rail     { background: rgba(97, 166, 221, 0.15); color: var(--sky); }
    .tag-one_out  { background: rgba(45, 212, 191, 0.15); color: var(--teal); }
    .tag-two_out  { background: rgba(251, 113, 133, 0.15); color: var(--coral); }
    .tag-forced   { background: rgba(249, 192, 21, 0.15); color: var(--gold); }
    .position-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 14px;
      font-family: var(--mono);
    }
    .position-cell .k {
      display: block;
      font-size: 9.5px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 4px;
      font-family: -apple-system, sans-serif;
      font-weight: 600;
    }
    .position-cell .v { font-size: 13px; font-weight: 500; }
    .position-cell .v2 {
      display: block;
      font-size: 10.5px;
      color: var(--text-muted);
      margin-top: 4px;
      font-family: var(--mono);
      font-weight: 400;
    }
    .position-cell .v2.dim { color: var(--text-dim); }

    .empty-state {
      color: var(--text-muted);
      padding: 32px 20px;
      text-align: center;
      font-size: 13px;
      line-height: 1.7;
    }
    .empty-state strong { color: var(--gold); font-weight: 600; }
    .empty-state .quote {
      font-style: italic;
      color: var(--text-dim);
      font-size: 12px;
      margin-top: 8px;
    }

    /* ─── Closes ──────────────────────────────────────────────────────── */
    .close-row {
      display: grid;
      grid-template-columns: 50px 1fr 110px 130px 120px;
      gap: 10px;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
      font-family: var(--mono);
      font-size: 13px;
    }
    .close-row:last-child { border-bottom: none; }
    .reason-chip {
      font-family: -apple-system, sans-serif;
      font-size: 10px;
      padding: 4px 10px;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      font-weight: 700;
      text-align: center;
      display: inline-block;
    }
    .reason-invalidation { background: rgba(251, 113, 133, 0.18); color: var(--coral); }
    .reason-take_profit  { background: rgba(45, 212, 191, 0.18); color: var(--teal); }
    .reason-time_stop    { background: rgba(249, 192, 21, 0.18); color: var(--gold); }
    .reason-plank_walk   { background: rgba(230, 0, 0, 0.18);    color: var(--rebel-red); }
    .reason-manual       { background: rgba(97, 166, 221, 0.18); color: var(--sky); }
    .reason-rotation     { background: rgba(139, 148, 158, 0.18); color: var(--text-muted); }

    /* ─── Decisions ───────────────────────────────────────────────────── */
    .decision {
      border-bottom: 1px solid var(--border);
      padding: 16px 0;
    }
    .decision:last-child { border-bottom: none; }
    .decision:first-child { padding-top: 4px; }
    .decision-head {
      display: flex;
      align-items: baseline;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 10px;
    }
    .decision-runid {
      font-family: var(--mono);
      color: var(--text-muted);
      font-size: 12px;
      font-weight: 600;
    }
    .decision-action {
      font-weight: 700;
      font-size: 11px;
      padding: 3px 10px;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }
    .action-enter { background: rgba(45, 212, 191, 0.18); color: var(--teal); }
    .action-hold  { background: rgba(139, 148, 158, 0.15); color: var(--text-muted); }
    .decision-type {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--text-dim);
      padding: 2px 8px;
      background: var(--bg-deep);
      border-radius: 4px;
    }
    .decision-time {
      margin-left: auto;
      font-size: 11px;
      color: var(--text-dim);
      font-family: var(--mono);
    }
    .decision-thesis {
      font-size: 13.5px;
      color: var(--text-primary);
      line-height: 1.75;
      margin-top: 8px;
      white-space: pre-wrap;
      padding-left: 12px;
      border-left: 2px solid var(--border);
    }
    .decision-confidence {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 8px;
      font-family: var(--mono);
      letter-spacing: 0.3px;
    }

    /* ─── Plank walks ─────────────────────────────────────────────────── */
    .plank-walk {
      border: 1px solid rgba(230, 0, 0, 0.4);
      border-left: 3px solid var(--rebel-red);
      border-radius: 6px;
      padding: 14px 16px;
      margin-bottom: 10px;
      background: rgba(230, 0, 0, 0.04);
    }
    .plank-walk-head {
      font-size: 14px;
      font-weight: 700;
      color: var(--rebel-red);
      margin-bottom: 6px;
      letter-spacing: -0.2px;
    }
    .plank-walk-detail {
      font-size: 12px;
      color: var(--text-muted);
      font-family: var(--mono);
    }

    /* ─── Footer ──────────────────────────────────────────────────────── */
    footer {
      margin-top: 36px;
      padding-top: 24px;
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }
    @media (max-width: 640px) {
      footer { flex-direction: column; text-align: center; }
    }
    .footer-brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .footer-brand img {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1.5px solid var(--gold);
      background: var(--gold);
    }
    .footer-brand-text {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--text-dim);
      letter-spacing: 0.6px;
      line-height: 1.6;
    }
    .footer-brand-text strong {
      color: var(--gold);
      font-weight: 600;
      letter-spacing: 1px;
    }
    .footer-status {
      text-align: right;
      color: var(--text-dim);
      font-size: 11px;
      font-family: var(--mono);
      letter-spacing: 0.4px;
    }
    .footer-status .heart {
      color: var(--coral);
      animation: pulse 2s ease-in-out infinite;
      display: inline-block;
    }
    .footer-status .signoff {
      margin-top: 4px;
      color: var(--text-dim);
      letter-spacing: 1px;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <!-- Hero banner with plank-hero image -->
    <header class="hero">
      <div class="hero-image"></div>
      <div class="hero-overlay"></div>
      <div class="hero-brand"></div>
      <div class="hero-content">
        <h1><span class="pirate">🏴‍☠️</span> Capt's Ledger</h1>
        <div class="tagline">
          <span class="phrase">The Watch</span>
          <span class="sep">·</span>
          <span class="phrase">Built on <span class="accent">Kraken CLI</span></span>
          <span class="sep">·</span>
          <span class="phrase">By Capt. Crawl for the Boons</span>
          <span class="sep">·</span>
          <span class="phrase accent">B4E</span>
        </div>
      </div>
    </header>

    <!-- Live account stats -->
    <div class="stats">
      <div class="stat equity" id="stat-equity-card">
        <div class="stat-label">Account Equity</div>
        <div class="stat-value mono" id="stat-equity">—</div>
        <div class="stat-sub" id="stat-equity-sub">&nbsp;</div>
      </div>
      <div class="stat" id="stat-pnl-card">
        <div class="stat-label">Session P&L</div>
        <div class="stat-value mono" id="stat-pnl">—</div>
        <div class="stat-sub" id="stat-pnl-sub">&nbsp;</div>
      </div>
      <div class="stat" id="stat-scheduler-card">
        <div class="stat-label">Scheduler</div>
        <div class="stat-value" id="stat-scheduler">—</div>
        <div class="stat-sub" id="stat-scheduler-sub">&nbsp;</div>
      </div>
    </div>

    <!-- Markets — live ticker cards for all 6 watched pairs -->
    <div class="markets" id="markets"></div>

    <section id="stack-section">
      <h2>Stack Progress <span class="count" id="stack-status">—</span></h2>
      <div id="stack"></div>
    </section>

    <section>
      <h2>Equity Curve <span class="count" id="equity-count">—</span></h2>
      <div class="chart-wrap chart" id="chart"></div>
    </section>

    <section>
      <h2>Open Positions <span class="count" id="positions-count">—</span></h2>
      <div id="positions"></div>
    </section>

    <section>
      <h2>Recent Decisions <span class="count" id="decisions-count">—</span></h2>
      <div id="decisions"></div>
    </section>

    <section>
      <h2>Recent Closes <span class="count" id="closes-count">—</span></h2>
      <div id="closes"></div>
    </section>

    <section id="plank-walks-section" style="display: none;">
      <h2>Plank Walks <span class="count" id="plank-walks-count">—</span></h2>
      <div id="plank-walks"></div>
    </section>

    <footer>
      <div class="footer-brand">
        <img src="/captcrawl.png" alt="Capt. Crawl" />
        <div class="footer-brand-text">
          <strong>CAPT. CRAWL</strong><br>
          The Watch · B4E · 4ever
        </div>
      </div>
      <div class="footer-status">
        <div class="refresh-status" id="refresh-status">connecting...</div>
        <div class="signoff">🏴‍☠️ built on kraken cli</div>
      </div>
    </footer>
  </div>

  <script>
    const fmtUsd = (v) => {
      if (v === null || v === undefined) return '—';
      const sign = v < 0 ? '-' : '';
      return sign + '$' + Math.abs(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };
    const fmtUsdSigned = (v) => {
      if (v === null || v === undefined) return '—';
      const sign = v >= 0 ? '+' : '-';
      return sign + '$' + Math.abs(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };
    const fmtPct = (v) => {
      if (v === null || v === undefined) return '—';
      const sign = v >= 0 ? '+' : '';
      return sign + v.toFixed(2) + '%';
    };
    const fmtPrice = (v) => {
      if (v === null || v === undefined) return '—';
      if (v >= 100) return '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (v >= 1)   return '$' + v.toFixed(4);
      return '$' + v.toFixed(6);
    };
    const fmtVolume = (v) => {
      if (v === null || v === undefined) return '—';
      if (v >= 1)    return v.toLocaleString('en-US', { maximumFractionDigits: 4 });
      if (v >= 0.01) return v.toFixed(4);
      return v.toFixed(8);
    };
    const fmtCtTime = (iso) => {
      try {
        return new Date(iso).toLocaleString('en-US', {
          timeZone: 'America/Chicago',
          month: 'short', day: 'numeric',
          hour: '2-digit', minute: '2-digit',
          hour12: true,
        }) + ' CT';
      } catch { return '—'; }
    };
    const fmtHours = (h) => {
      if (h === null || h === undefined || h <= 0) return '0h 0m';
      const hours = Math.floor(h);
      const mins = Math.round((h - hours) * 60);
      return hours + 'h ' + mins + 'm';
    };
    const pnlClass = (v) => v >= 0 ? 'pos' : 'neg';

    function renderState(state) {
      const account = state.account;
      const equityEl = document.getElementById('stat-equity');
      const equitySubEl = document.getElementById('stat-equity-sub');
      const pnlEl = document.getElementById('stat-pnl');
      const pnlSubEl = document.getElementById('stat-pnl-sub');
      const pnlCardEl = document.getElementById('stat-pnl-card');
      const schedEl = document.getElementById('stat-scheduler');
      const schedSubEl = document.getElementById('stat-scheduler-sub');
      const schedCardEl = document.getElementById('stat-scheduler-card');

      if (account) {
        equityEl.textContent = fmtUsd(account.current_value);
        equitySubEl.textContent = '— from $' + account.starting_balance.toLocaleString('en-US', { minimumFractionDigits: 2 }) + ' baseline';
        pnlEl.textContent = fmtPct(account.pnl_pct);
        pnlEl.className = 'stat-value mono ' + pnlClass(account.pnl_pct);
        pnlCardEl.className = 'stat ' + (account.pnl_pct >= 0 ? 'pnl-pos' : 'pnl-neg');
        // Surface the dollar P&L alongside the trade count. Showing both the
        // percent (big) and dollar (sub) makes the card honest at a glance —
        // a 0.5% drawdown is very different from a 50% drawdown, and the
        // dollar number is the one that fits in your head.
        const pnlUsdStr = account.pnl_usd !== undefined && account.pnl_usd !== null
          ? fmtUsdSigned(account.pnl_usd) + ' · '
          : '';
        pnlSubEl.textContent = pnlUsdStr + account.total_trades + ' total trades this session';
      } else {
        equityEl.textContent = '—';
        pnlEl.textContent = '—';
        equitySubEl.textContent = 'kraken cli unreachable';
        pnlSubEl.textContent = '';
      }
      if (state.paused) {
        schedEl.innerHTML = '<span class="paused-indicator"><span class="paused-dot"></span>PAUSED</span>';
        schedSubEl.textContent = 'scheduled fires skipped · manual fires still work';
        schedCardEl.className = 'stat paused';
      } else {
        schedEl.innerHTML = '<span class="active-indicator"><span class="pulse-dot"></span>ACTIVE</span>';
        schedSubEl.textContent = '9am / 9pm CT bridges · 3am / 3pm CT exit-checks';
        schedCardEl.className = 'stat active';
      }
      renderPositions(state.positions || []);
    }

    const PAIR_META = {
      HBARUSD:  { symbol: 'HBAR',  desc: 'HBARBARIANS · STACK TARGET',  cls: 't-hbar' },
      BTCUSD:   { symbol: 'BTC',   desc: 'THE RESERVE · VEHICLE',       cls: 't-btc' },
      DOGUSD:   { symbol: 'DOG',   desc: 'DOG ARMY · STACK TARGET',     cls: 't-dog' },
      SOLUSD:   { symbol: 'SOL',   desc: 'SOLANA · VEHICLE',            cls: 't-sol' },
      SUIUSD:   { symbol: 'SUI',   desc: 'SUI · VEHICLE',               cls: 't-sui' },
    };

    function renderTickers(tickers) {
      const container = document.getElementById('markets');
      if (!tickers || tickers.length === 0) {
        container.innerHTML = '';
        return;
      }
      container.innerHTML = tickers.map(t => {
        const meta = PAIR_META[t.pair] || { symbol: t.pair, desc: '', cls: '' };
        const changeHtml = t.pct_change_24h !== null
          ? `<span class="ticker-change ${pnlClass(t.pct_change_24h)}">${fmtPct(t.pct_change_24h)}</span>`
          : '<span class="ticker-change dim">—</span>';
        const rangeHtml = (t.low_24h !== null && t.high_24h !== null)
          ? `<span class="ticker-range">${fmtPrice(t.low_24h)} – ${fmtPrice(t.high_24h)}</span>`
          : '';
        return `
          <div class="ticker ${meta.cls}">
            <div class="ticker-head">
              <span>
                <span class="ticker-symbol">${meta.symbol}</span>
                <span class="ticker-quote">/ USD</span>
              </span>
              <span class="ticker-desc">${meta.desc}</span>
            </div>
            <div class="ticker-price">${fmtPrice(t.last)}</div>
            <div class="ticker-foot">
              ${changeHtml}
              ${rangeHtml}
            </div>
          </div>`;
      }).join('');
    }

    function renderPositions(positions) {
      const container = document.getElementById('positions');
      document.getElementById('positions-count').textContent = '(' + positions.length + ')';
      if (positions.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <strong>Marker on the deck.</strong><br>
            No positions held — Capt is reading the books.
            <div class="quote">"The discipline is not manufacturing signal where there isn't any."</div>
          </div>`;
        return;
      }
      container.innerHTML = positions.map(p => {
        const cardClass = p.forced ? 'forced' : ('tier-' + p.size_label);
        const tag = p.forced
          ? '<span class="position-tag tag-forced">FORCED</span>'
          : '<span class="position-tag tag-' + p.size_label + '">' + p.size_label + '</span>';
        const pnlUsdHtml = p.unrealized_pnl_usd !== null
          ? '<span class="' + pnlClass(p.unrealized_pnl_usd) + '">' + fmtUsdSigned(p.unrealized_pnl_usd) + '</span>'
          : '—';
        const pnlPctHtml = p.unrealized_pnl_pct !== null
          ? '<span class="' + pnlClass(p.unrealized_pnl_pct) + '">' + fmtPct(p.unrealized_pnl_pct) + '</span>'
          : '—';
        const valueHtml = p.current_value_usd !== null ? fmtUsd(p.current_value_usd) : '—';
        return `
          <div class="position ${cardClass}">
            <div class="position-head">
              <div>
                <span class="position-pair">${p.pair}</span>
                ${tag}
              </div>
              <div class="muted mono" style="font-size: 11px;">opened ${fmtCtTime(p.opened_at)}</div>
            </div>
            <div class="position-row">
              <div class="position-cell">
                <span class="k">Holding</span>
                <span class="v">${fmtVolume(p.volume)} ${p.symbol}</span>
                <span class="v2">${fmtUsd(p.cost_usd)} @ ${fmtPrice(p.fill_price)} entry</span>
              </div>
              <div class="position-cell">
                <span class="k">Current Value</span>
                <span class="v">${valueHtml}</span>
                <span class="v2">@ ${fmtPrice(p.current_price)} mark</span>
              </div>
              <div class="position-cell">
                <span class="k">Unrealized</span>
                <span class="v">${pnlUsdHtml}</span>
                <span class="v2">${pnlPctHtml}</span>
              </div>
              <div class="position-cell">
                <span class="k">Invalidation</span>
                <span class="v">${p.invalidation_price !== null ? fmtPrice(p.invalidation_price) : '—'}</span>
                <span class="v2 dim">loss exit</span>
              </div>
              <div class="position-cell">
                <span class="k">Take-Profit</span>
                <span class="v">${p.take_profit_price !== null ? fmtPrice(p.take_profit_price) : '—'}</span>
                <span class="v2 dim">win exit</span>
              </div>
              <div class="position-cell">
                <span class="k">Time-Stop</span>
                <span class="v">${fmtHours(p.hours_to_time_stop)}</span>
                <span class="v2 dim">forced exit</span>
              </div>
            </div>
          </div>`;
      }).join('');
    }

    function renderEquity(snapshots) {
      const container = document.getElementById('chart');
      document.getElementById('equity-count').textContent = '(' + snapshots.length + ' snapshot' + (snapshots.length === 1 ? '' : 's') + ')';
      if (snapshots.length === 0) {
        container.innerHTML = `
          <div class="chart-empty">
            <strong>Awaiting first snapshot.</strong><br>
            The curve will fill in as the watch runs: <br>
            two snapshots per day from each Bridge Log, two more from each Exit-Check.
          </div>`;
        return;
      }
      const W = 900, H = 240;
      const padL = 56, padR = 14, padT = 18, padB = 30;
      const innerW = W - padL - padR;
      const innerH = H - padT - padB;
      const xs = snapshots.map(s => new Date(s.ts).getTime());
      const ys = snapshots.map(s => s.value);
      const starting = snapshots[0].starting || 10000;
      const xMin = Math.min(...xs);
      const xMax = Math.max(...xs);
      const xRange = Math.max(1, xMax - xMin);
      const yMinRaw = Math.min(...ys, starting);
      const yMaxRaw = Math.max(...ys, starting);
      const yPad = (yMaxRaw - yMinRaw) * 0.15 || 100;
      const yMin = yMinRaw - yPad;
      const yMax = yMaxRaw + yPad;
      const yRange = Math.max(1, yMax - yMin);
      const sx = (x) => padL + ((x - xMin) / xRange) * innerW;
      const sy = (y) => padT + (1 - (y - yMin) / yRange) * innerH;
      const pts = snapshots.map(s => ({ x: sx(new Date(s.ts).getTime()), y: sy(s.value) }));
      const linePoints = pts.map(p => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
      const fillPath = `M ${pts[0].x.toFixed(1)},${(padT + innerH).toFixed(1)} ` +
        pts.map(p => `L ${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ') +
        ` L ${pts[pts.length - 1].x.toFixed(1)},${(padT + innerH).toFixed(1)} Z`;
      const yTicks = 4;
      const yLabels = [];
      for (let i = 0; i <= yTicks; i++) {
        const v = yMin + (yRange / yTicks) * i;
        const y = sy(v);
        yLabels.push(`<text class="chart-label" x="${padL - 8}" y="${y + 3}" text-anchor="end">$${Math.round(v).toLocaleString('en-US')}</text>`);
        yLabels.push(`<line class="chart-axis" x1="${padL}" y1="${y}" x2="${W - padR}" y2="${y}" opacity="0.25" />`);
      }
      const xLabels = [];
      [0, 0.5, 1].forEach(frac => {
        const ts = xMin + xRange * frac;
        const x = padL + frac * innerW;
        const label = new Date(ts).toLocaleString('en-US', { timeZone: 'America/Chicago', month: 'short', day: 'numeric', hour: 'numeric', hour12: true });
        xLabels.push(`<text class="chart-label" x="${x}" y="${H - padB + 16}" text-anchor="middle">${label}</text>`);
      });
      const baseY = sy(starting);
      const baselineEl = `<line class="chart-baseline" x1="${padL}" y1="${baseY}" x2="${W - padR}" y2="${baseY}" />
                          <text class="chart-label" x="${W - padR - 6}" y="${baseY - 5}" text-anchor="end" style="fill: var(--text-dim);">$${starting.toLocaleString('en-US')} baseline</text>`;
      const dots = pts.map(p => `<circle class="chart-dot" cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="3.5" />`).join('');
      container.innerHTML = `
        <svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="equityGradient" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#2DD4BF" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#2DD4BF" stop-opacity="0" />
            </linearGradient>
          </defs>
          ${yLabels.join('')}
          <path class="chart-fill" d="${fillPath}" />
          ${baselineEl}
          <polyline class="chart-line" points="${linePoints}" />
          ${dots}
          ${xLabels.join('')}
        </svg>`;
    }

    function renderCloses(closes) {
      const container = document.getElementById('closes');
      document.getElementById('closes-count').textContent = '(' + closes.length + ')';
      if (closes.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <strong>No closes filed yet.</strong><br>
            Positions exit on <span class="pos">take-profit</span>, <span class="neg">invalidation</span>, or <span style="color: var(--gold);">time-stop</span>.
            <div class="quote">"The marker returns to the deck when the book stops earning it."</div>
          </div>`;
        return;
      }
      container.innerHTML = closes.map(c => {
        const reasonClass = 'reason-' + (c.exit_reason || 'manual');
        const reasonLabel = (c.exit_reason || 'manual').replace('_', ' ');
        const pnlHtml = c.pnl_usd !== null
          ? '<span class="' + pnlClass(c.pnl_usd) + '">' + fmtUsdSigned(c.pnl_usd) + ' (' + fmtPct(c.pnl_pct) + ')</span>'
          : '—';
        return `
          <div class="close-row">
            <span class="muted">#${c.trade_id}</span>
            <span><strong>${c.pair}</strong> <span class="muted">${c.size_label}</span></span>
            <span><span class="reason-chip ${reasonClass}">${reasonLabel}</span></span>
            <span class="muted">${fmtPrice(c.fill_price)} → ${fmtPrice(c.exit_price)}</span>
            <span style="text-align: right;">${pnlHtml}</span>
          </div>`;
      }).join('');
    }

    function renderDecisions(decisions) {
      const container = document.getElementById('decisions');
      document.getElementById('decisions-count').textContent = '(' + decisions.length + ')';
      if (decisions.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <strong>Capt is watching.</strong><br>
            Decision history populates after the next watch.
          </div>`;
        return;
      }
      container.innerHTML = decisions.map(d => {
        const actionTxt = (d.action || '—').toUpperCase();
        const actionClass = d.action === 'enter' ? 'action-enter' : 'action-hold';
        const actionLabel = d.action === 'enter' && d.pair
          ? `${actionTxt} ${d.pair} <span class="muted">${d.size || ''}</span>`
          : actionTxt;
        const thesis = (d.thesis || '').trim();
        const conf = d.confidence ? 'Confidence: ' + d.confidence : '';
        return `
          <div class="decision">
            <div class="decision-head">
              <span class="decision-runid">#${d.run_id}</span>
              <span class="decision-action ${actionClass}">${actionLabel}</span>
              <span class="decision-type">${d.run_type}</span>
              <span class="decision-time">${fmtCtTime(d.run_ts_utc)}</span>
            </div>
            ${thesis ? `<div class="decision-thesis">${escapeHtml(thesis)}</div>` : ''}
            ${conf ? `<div class="decision-confidence">${conf}</div>` : ''}
          </div>`;
      }).join('');
    }

    function renderPlankWalks(walks) {
      const section = document.getElementById('plank-walks-section');
      const container = document.getElementById('plank-walks');
      document.getElementById('plank-walks-count').textContent = '(' + walks.length + ')';
      if (walks.length === 0) {
        section.style.display = 'none';
        return;
      }
      section.style.display = '';
      container.innerHTML = walks.map(w => {
        const reasonLabel = (w.reason || 'unknown').replace(/_/g, ' ');
        const dayStr = w.days_alive ? `${w.days_alive} day${w.days_alive === 1 ? '' : 's'} alive` : null;
        const tradeStr = (w.total_trades !== null && w.total_trades !== undefined) ? `${w.total_trades} total trade${w.total_trades === 1 ? '' : 's'}` : null;
        const winnerStr = (w.biggest_winner_usd !== null && w.biggest_winner_usd !== undefined)
          ? `biggest winner ${fmtUsdSigned(w.biggest_winner_usd)}` : null;
        const chopStr = (w.biggest_chop_usd !== null && w.biggest_chop_usd !== undefined)
          ? `biggest chop ${fmtUsdSigned(w.biggest_chop_usd)}` : null;
        const detailParts = [dayStr, tradeStr, winnerStr, chopStr].filter(Boolean);
        return `
          <div class="plank-walk">
            <div class="plank-walk-head">☠ Plank walked ${fmtCtTime(w.ts_utc)} <span class="muted" style="font-weight: 400; font-size: 12px;">· ${escapeHtml(reasonLabel)}</span></div>
            <div class="plank-walk-detail">
              Reset to ${fmtUsd(w.ending_equity_usd)}
              ${detailParts.length > 0 ? '· ' + detailParts.join(' · ') : ''}
            </div>
          </div>`;
      }).join('');
    }

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    async function fetchJson(path) {
      const r = await fetch(path, { cache: 'no-store' });
      if (!r.ok) throw new Error(`${path} returned ${r.status}`);
      return r.json();
    }

    function renderStack(stack) {
      const container = document.getElementById('stack');
      const status = document.getElementById('stack-status');
      if (!stack || !stack.available) {
        container.innerHTML = `
          <div class="empty-state">
            <strong>Stack baseline pending.</strong><br>
            Stack progress activates after the first Bridge Log writes a baseline snapshot.
            ${stack && stack.reason ? '<div class="quote">' + escapeHtml(stack.reason) + '</div>' : ''}
          </div>`;
        status.textContent = '— pending';
        return;
      }
      const targets = stack.targets || {};
      const formatUnits = (n) => {
        if (Math.abs(n) >= 1e6) return (n / 1e6).toFixed(2) + 'M';
        if (Math.abs(n) >= 1e3) return (n / 1e3).toFixed(2) + 'K';
        if (Math.abs(n) >= 1)   return n.toFixed(2);
        return n.toFixed(6);
      };
      const rows = Object.entries(targets).map(([sym, t]) => {
        if (!t.available) {
          return `<div class="stack-row"><strong>${sym}</strong><span class="muted">stack data unavailable</span></div>`;
        }
        const sign = t.deltaUnits >= 0 ? '+' : '';
        const cls = t.deltaUnits >= 0 ? 'pos' : 'neg';
        return `
          <div class="stack-row">
            <div class="stack-sym"><strong>${sym}</strong></div>
            <div class="stack-now">${formatUnits(t.currentEquivalent)} ${sym}<br><span class="muted">equiv now @ $${t.currentPrice}</span></div>
            <div class="stack-was">${formatUnits(t.baselineEquivalent)} ${sym}<br><span class="muted">baseline @ $${t.baselinePrice}</span></div>
            <div class="stack-delta ${cls}">${sign}${formatUnits(t.deltaUnits)} ${sym}<br><span class="${cls}">${sign}${t.deltaPct.toFixed(2)}%</span></div>
          </div>`;
      }).join('');
      container.innerHTML = `<div class="stack-grid">${rows}</div>`;
      const targetSummary = Object.entries(targets)
        .filter(([_, t]) => t.available)
        .map(([sym, t]) => {
          const sign = t.deltaPct >= 0 ? '+' : '';
          return `${sym} ${sign}${t.deltaPct.toFixed(2)}%`;
        }).join(' · ');
      status.textContent = targetSummary || '—';
    }

    async function refreshLive() {
      try {
        const [state, tickers, stack] = await Promise.all([
          fetchJson('/api/state'),
          fetchJson('/api/tickers').catch(() => ({ tickers: [] })),
          fetchJson('/api/stack').catch((e) => ({ available: false, reason: e.message })),
        ]);
        renderState(state);
        renderTickers(tickers.tickers || []);
        renderStack(stack);
        document.getElementById('refresh-status').innerHTML =
          'live <span class="heart">●</span> ' +
          new Date().toLocaleTimeString('en-US', { hour12: false, timeZone: 'America/Chicago' }) + ' CT';
      } catch (e) {
        document.getElementById('refresh-status').textContent = 'refresh failed: ' + e.message;
        console.error(e);
      }
    }

    async function refreshHistory() {
      try {
        const [equity, closes, decisions, planks] = await Promise.all([
          fetchJson('/api/equity'),
          fetchJson('/api/closes?limit=20'),
          fetchJson('/api/decisions?limit=20'),
          fetchJson('/api/plank-walks'),
        ]);
        renderEquity(equity.snapshots || []);
        renderCloses(closes.closes || []);
        renderDecisions(decisions.decisions || []);
        renderPlankWalks(planks.plank_walks || []);
      } catch (e) {
        console.error('refreshHistory failed:', e);
      }
    }

    refreshLive();
    refreshHistory();
    setInterval(refreshLive, 15_000);
    setInterval(refreshHistory, 60_000);
  </script>
</body>
</html>
